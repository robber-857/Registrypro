{
  "manifest_version": 3,
  "name": "Registrypro ASIC Assistant",
  "version": "2.1.0",
  "description": "在 ASIC 公共页面运行本机核对队列，读取免费摘要并回写 Registrypro。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://connectonline.asic.gov.au/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Registrypro ASIC 自动核对"
  },
  "content_scripts": [
    {
      "matches": [
        "https://connectonline.asic.gov.au/RegistrySearch/*"
      ],
      "js": [
        "reader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_permissions": [
    "activeTab"
  ]
}